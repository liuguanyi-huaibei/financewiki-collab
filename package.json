{
  "name": "@financewiki/obsidian-collab",
  "version": "0.3.0-dev.1",
  "private": true,
  "type": "module",
  "description": "FinanceWiki Yjs collaboration engine and Obsidian plugin",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "demo": "node demo/offline-two-peers.mjs",
    "build": "node ./esbuild.config.mjs",
    "build:watch": "node ./esbuild.config.mjs --watch",
    "signaling": "node ./node_modules/y-webrtc/bin/server.js",
    "signaling:managed": "node ./scripts/signaling-supervisor.mjs",
    "test:signaling": "node ./scripts/test-signaling-supervisor.mjs",
    "typecheck": "tsc --noEmit",
    "validate": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "lib0": "0.2.120",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "9.0.12",
    "y-webrtc": "10.3.0",
    "yjs": "13.6.33"
  },
  "devDependencies": {
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@types/node": "24.10.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "6.2.8",
    "jsdom": "26.1.0",
    "obsidian": "1.14.4",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
